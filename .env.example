# hybrid 會結合本機 SLM 與 Gemini；auto 則沿用 OpenAI／本機規則模式。
ANALYZER_BACKEND=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_CHARS=12000

# ANALYZER_BACKEND=slm 或 hybrid 時使用；可填模型 ID 或本機資料夾。
SLM_MODEL=MoritzLaurer/multilingual-MiniLMv2-L6-mnli-xnli
SLM_MAX_CHARS=6000

# 背景防護預設每 5 分鐘檢查一次，每次查看最新 20 封收件匣郵件。
BACKGROUND_SCAN_SECONDS=300
BACKGROUND_SCAN_LIMIT=20

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
