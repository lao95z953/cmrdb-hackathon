# 預設只使用本機 SLM，不會將郵件內容傳送至外部模型。
ANALYZER_BACKEND=slm

# 本機二元 phishing classifier。模型未提供 label mapping，因此在此明確指定。
SLM_MODEL=songhieng/chn-roberta-phishing-content-detector-1.0
SLM_PHISHING_LABEL=LABEL_1
SLM_MIN_CONFIDENCE=0.75
SLM_MAX_CHARS=6000
SLM_MAX_SEGMENTS=8

# 只有明確將 ANALYZER_BACKEND 改成 openai 或 gemini 時才會使用。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_CHARS=12000

# 背景防護預設每 5 分鐘檢查一次，每次查看最新 20 封收件匣郵件。
BACKGROUND_SCAN_SECONDS=300
BACKGROUND_SCAN_LIMIT=20

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
